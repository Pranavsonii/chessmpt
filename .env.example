# ---------- Postgres (docker-compose) ----------
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
POSTGRES_DB=chess
POSTGRES_PORT=5432

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://chess:chess@localhost:5432/chess
# Use a long random string in real environments: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Browser origin allowed by CORS / Socket.IO
WEB_ORIGIN=http://localhost:3000

# ---------- Web (apps/web) ----------
# Where Next.js proxies /api/* to (server-side)
API_INTERNAL_URL=http://localhost:4000
# Where the browser opens the Socket.IO connection
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
